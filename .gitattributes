# 云端 macOS runner 必须拿到 LF 换行，否则 build.sh 会 bad interpreter
* text=auto

*.sh          text eol=lf
*.py          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.js          text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.json        text eol=lf
*.plist       text eol=lf
*.webmanifest text eol=lf
*.svg         text eol=lf
*.md          text eol=lf
*.m           text eol=lf

*.png  binary
*.ipa  binary
